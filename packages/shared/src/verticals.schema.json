{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearcher.local/schemas/verticals.json",
  "title": "Vertical allowlist",
  "type": "object",
  "required": ["version", "updated", "verticals", "policies"],
  "properties": {
    "version": { "type": "string" },
    "updated": { "type": "string", "format": "date" },
    "verticals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "name", "description", "queries"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 10 },
          "queries": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "exclusions": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "policies": {
      "type": "object",
      "required": ["rejectIfOutsideAllowlist", "addProcedure"],
      "properties": {
        "rejectIfOutsideAllowlist": { "type": "boolean" },
        "addProcedure": { "type": "string" }
      }
    }
  }
}

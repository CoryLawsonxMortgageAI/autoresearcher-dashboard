# Copy to .env (local only) or sync from Vercel via `pnpm sync-secrets`.
# DO NOT commit .env. The hook in .claude/hooks.json hard-blocks .env writes.

# --- Database (PlanetScale or any MySQL/Vitess) ---
DATABASE_URL="mysql://user:pass@host:3306/autoresearcher?ssl={\"rejectUnauthorized\":true}"
DATABASE_URL_RO=""

# --- Live events (Pusher) ---
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="us3"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us3"

# --- Auth (magic link signing) ---
JWT_SIGNING_KEY="generate-32-plus-random-chars-locally"
MAGIC_LINK_TTL_SECONDS="900"
OPERATOR_EMAIL="cory@example.com"
OPERATOR_NAME="Cory"

# --- Email digest ---
RESEND_API_KEY=""
DIGEST_FROM="autoresearcher@autoresearcher.local"
DIGEST_TO="cory@example.com"

# --- Observability ---
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""

# --- LLM provider (SCOUT/CRITIC) ---
ANTHROPIC_API_KEY=""

# --- Notion sync (optional) ---
NOTION_API_KEY=""
NOTION_OPPORTUNITIES_DB=""
NOTION_BLOCKERS_DB=""

# --- Obsidian export (optional) ---
# Path to the Obsidian vault on the host running the worker. If unset, export
# is skipped silently.
OBSIDIAN_VAULT_PATH=""
OBSIDIAN_OPPORTUNITIES_DIR="Autoresearcher/Opportunities"

# --- Vercel CLI (for sync-secrets script) ---
VERCEL_TOKEN=""
VERCEL_PROJECT=""
VERCEL_SCOPE=""
VERCEL_ENVIRONMENT="production"

# --- Cron schedules (override only if you really mean it) ---
SCOUT_CRON="0 3 * * *"
DIGEST_CRON="0 9 * * MON"
INFLIGHT_CRON="0 * * * *"

# --- Feature flags ---
# DO NOT set AUTOMERGE_AUTHORIZED here. It must come from Vercel env after the
# signed `/.automerge-authorized` file is present and 24h has elapsed. See
# docs/adr/0006-merge-policy.md.
AUTOMERGE_AUTHORIZED=""

# --- Service URLs (set per environment) ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
API_INTERNAL_BASE="http://localhost:3001"
WEB_BASE_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# --- Allowlist override (testing only) ---
# Comma-separated vertical slugs. Empty = use packages/skills/autoresearcher/verticals.json.
VERTICAL_ALLOWLIST_OVERRIDE=""
